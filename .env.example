# Copy this file to .env and adjust values before running `docker compose up`.
# docker compose reads .env automatically (same directory as compose.yaml).

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password

# --- PostgREST ----------------------------------------------------------------
POSTGREST_IMAGE=postgrest/postgrest:v16.2
PGRST_DB_SCHEMA=public
PGRST_DB_ANON_ROLE=anon
PGRST_DB_AUTH_ROLE=authenticator
PGRST_DB_AUTH_PASSWORD=auth_password
PGRST_JWT_SECRET=dev_only_secret_change_me_at_least_32_chars

# --- pgproxy (vendored build, see docs/infra/pgproxy.md) ----------------------
# Port pgproxy listens on inside the postgrest/driver containers
PGPROXY_PORT=5432
# Upstream database pgproxy forwards to
PGPROXY_TARGET=postgres:5432

# --- API gateway (nginx) ------------------------------------------------------
NGINX_IMAGE=nginx:1.27-alpine
# The ONLY host-accessible API port: the gateway
NGINX_PORT=8080

# --- Identity provider (keycloak-mockup) --------------------------------------
IDP_IMAGE=ghcr.io/calcite/keycloak-mockup:latest
# Host port clients use to reach the IdP directly (like a real external IdP)
IDP_PORT=5151
IDP_REALM=myrealm
IDP_CLIENT_ID=myclient

# --- pgrmapper tuning ---------------------------------------------------------
PGMAPPER_DB_POOL_MIN=1
PGMAPPER_DB_POOL_MAX=10
# How requests referencing non-visible columns are handled:
# allow = forward them, enforce = strip them, reject = 403 (default)
PGMAPPER_QUERY_POLICY=reject
